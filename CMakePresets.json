{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Developer Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MEAT2D_BUILD_CLIENT": "ON",
        "MEAT2D_BUILD_SERVER": "ON",
        "MEAT2D_BUILD_TESTS": "ON",
        "MEAT2D_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "headless",
      "displayName": "Headless Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/headless",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MEAT2D_BUILD_CLIENT": "OFF",
        "MEAT2D_BUILD_LAUNCHER": "OFF",
        "MEAT2D_BUILD_EXAMPLES": "OFF",
        "MEAT2D_BUILD_SERVER": "ON",
        "MEAT2D_BUILD_TESTS": "ON",
        "MEAT2D_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "asan-headless",
      "displayName": "AddressSanitizer Headless Debug",
      "inherits": "headless",
      "binaryDir": "${sourceDir}/build/asan-headless",
      "cacheVariables": {
        "MEAT2D_SANITIZER": "address"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MEAT2D_BUILD_CLIENT": "ON",
        "MEAT2D_BUILD_SERVER": "ON",
        "MEAT2D_BUILD_TESTS": "ON",
        "MEAT2D_BUILD_BENCHMARKS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "headless",
      "configurePreset": "headless"
    },
    {
      "name": "asan-headless",
      "configurePreset": "asan-headless"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "headless",
      "configurePreset": "headless",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan-headless",
      "configurePreset": "asan-headless",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
